---
export const prerender = false;
import type { DayMetadata } from "@daily-tech/core";

import AdminLayout from "../../layouts/AdminLayout.astro";
import CalendarMonth from "../../components/CalendarMonth.astro";
import { toIsraelDate } from "../../lib/dates.js";
import { openServerDatabase } from "../../server/database.js";

const db = await openServerDatabase();
const days: DayMetadata[] = [];
for (let offset = 0; ; offset += 1000) {
  const page = db.listDays({ order: "asc", limit: 1000, offset });
  days.push(...page);
  if (page.length < 1000) break;
}
db.close();

const currentDate = toIsraelDate();
const month = currentDate.slice(0, 7);
---
<AdminLayout title="ניהול תדריכים">
  <h1 class="admin-page-title">ניהול תדריכים</h1>
  <CalendarMonth
    month={month}
    currentDate={currentDate}
    days={days}
    hrefBase="/admin/briefs"
    dayActionLabel="עריכת המהדורה"
  />
</AdminLayout>
