---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadSiteSnapshot } from "../lib/content.js";
import { addCalendarDays, formatHebrewDate } from "../lib/dates.js";
import {
  calculateStatistics,
  parseStatisticsRange,
  selectTrailingDays,
  STATISTICS_RANGE_DAYS,
} from "../lib/statistics.js";

export const prerender = false;
const snapshot = await loadSiteSnapshot();
const selectedRange = parseStatisticsRange(Astro.url.searchParams.get("range"));
const rangeDays = STATISTICS_RANGE_DAYS[selectedRange];
const rangeStart = addCalendarDays(snapshot.currentDate, -rangeDays);
const rangeEnd = addCalendarDays(snapshot.currentDate, -1);
const selectedDays = selectTrailingDays(
  snapshot.published.map((brief) => brief.metadata),
  snapshot.currentDate,
  selectedRange,
);
const stats = calculateStatistics(selectedDays);
const intensityLabels = { minimal: "שקט", low: "נמוך", medium: "בינוני", high: "גבוה", extreme: "חריג" } as const;
const maxIntensity = Math.max(...Object.values(stats.intensityCounts), 1);
const intensityScores = { minimal: 1, low: 2, medium: 3, high: 4, extreme: 5 } as const;
const chartDays = [...selectedDays].sort((left, right) => left.date.localeCompare(right.date));
const millisecondsPerDay = 86_400_000;
const chartStartDate = chartDays[0]?.date ?? rangeStart;
const chartEndDate = chartDays.at(-1)?.date ?? rangeEnd;
const chartSpanDays = Math.max(
  Math.round((Date.parse(`${chartEndDate}T00:00:00Z`) - Date.parse(`${chartStartDate}T00:00:00Z`)) / millisecondsPerDay),
  1,
);
const chartPoints = chartDays.map((day) => {
  const offset = Math.round((Date.parse(`${day.date}T00:00:00Z`) - Date.parse(`${chartStartDate}T00:00:00Z`)) / millisecondsPerDay);
  const x = chartDays.length === 1 ? 500 : 24 + (offset / chartSpanDays) * 952;
  const y = 225 - (intensityScores[day.day_intensity] - 1) * 47;
  return { day, x, y };
});
const pointList = chartPoints.map(({ x, y }) => `${x.toFixed(2)},${y}`).join(" ");
const areaPath = chartPoints.length > 0
  ? `M ${chartPoints[0]?.x.toFixed(2)} 225 L ${pointList.replaceAll(" ", " L ")} L ${chartPoints.at(-1)?.x.toFixed(2)} 225 Z`
  : "";
---

<BaseLayout description="מבט על קצב החדשות, החברות והנושאים הבולטים ב-Daily Tech.">
  <section class="shell statistics-page">
    <header class="statistics-header">
      <div>
        <h1 class="display-title">הסיפור שמאחורי הימים</h1>
      </div>
      <nav class="statistics-range" aria-label="טווח הסטטיסטיקות">
        <a href="/statistics?range=month" aria-current={selectedRange === "month" ? "page" : undefined}>חודש אחרון</a>
        <a href="/statistics?range=year" aria-current={selectedRange === "year" ? "page" : undefined}>שנה אחרונה</a>
      </nav>
    </header>

    <div class="stats-grid">
      <div class="stat-card"><span class="stat-number">{stats.briefCount}</span><span class="stat-label">מהדורות</span></div>
      <div class="stat-card"><span class="stat-number">{stats.developmentCount}</span><span class="stat-label">התפתחויות</span></div>
    </div>

    {stats.briefCount > 0 ? (
      <>
        <section class="statistics-panel trend-panel">
          <div class="statistics-panel-head">
            <div><p class="eyebrow">מגמה יומית</p><h2>עוצמת החדשות לאורך הזמן</h2></div>
          </div>
          <div class="trend-chart" data-range={selectedRange} role="img" aria-label={`גרף עוצמת החדשות ב־${rangeDays} הימים האחרונים`}>
            <span class="trend-label trend-label-high">חריג</span>
            <span class="trend-label trend-label-low">שקט</span>
            <svg viewBox="0 0 1000 260" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="trend-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="var(--accent)" stop-opacity=".28" />
                  <stop offset="1" stop-color="var(--accent)" stop-opacity="0" />
                </linearGradient>
              </defs>
              <g class="trend-grid">
                {[37, 84, 131, 178, 225].map((y) => <line x1="24" y1={y} x2="976" y2={y} />)}
              </g>
              <path class="trend-area" d={areaPath} />
              <polyline class="trend-line" points={pointList} />
            </svg>
          </div>
          <div class="trend-axis"><span>{formatHebrewDate(chartStartDate)}</span><span>{formatHebrewDate(chartEndDate)}</span></div>
        </section>

        <div class="rankings">
          <section class="statistics-panel ranking-panel">
            <div class="statistics-panel-head"><div><p class="eyebrow">Top 10</p><h2>חברות מובילות</h2></div></div>
            <ol class="ranking-list">
              {stats.topCompanies.map((item, index) => (
                <li>
                  <span class="rank">{index + 1}</span><strong>{item.name}</strong><span class="count">{item.count} ימים</span>
                </li>
              ))}
            </ol>
          </section>
          <section class="statistics-panel ranking-panel">
            <div class="statistics-panel-head"><div><p class="eyebrow">Top 10</p><h2>נושאים מובילים</h2></div></div>
            <ol class="ranking-list">
              {stats.topTopics.map((item, index) => (
                <li>
                  <span class="rank">{index + 1}</span><strong>{item.name}</strong><span class="count">{item.count} ימים</span>
                </li>
              ))}
            </ol>
          </section>
        </div>

        <section class="statistics-panel news-pace-panel">
          <div class="statistics-panel-head"><div><p class="eyebrow">התפלגות</p><h2>קצב החדשות</h2></div></div>
          <div class="intensity-bars">
            {Object.entries(stats.intensityCounts).map(([level, count]) => (
              <div class="bar-row" data-level={level}>
                <span>{intensityLabels[level as keyof typeof intensityLabels]}</span>
                <div class="bar-track"><div class="bar-fill" style={`width:${(count / maxIntensity) * 90}%`}></div></div>
                <strong>{count} ימים</strong>
              </div>
            ))}
          </div>
        </section>
      </>
    ) : (
      <div class="status-note"><span class="status-dot"></span><span>אין מהדורות שפורסמו בטווח הזה.</span></div>
    )}
  </section>
</BaseLayout>
