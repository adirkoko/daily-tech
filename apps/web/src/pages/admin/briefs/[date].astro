---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import EditorFormControls from "../../../components/EditorFormControls.astro";
import { loadAdminBrief } from "../../../server/admin-content.js";
import { loadAdminBriefGenerationInfo } from "../../../server/admin-research-trace.js";

const date = Astro.params.date ?? "";
const brief = await loadAdminBrief(date);
if (!brief) return Astro.redirect("/admin?error=brief-not-found", 303);
const { metadata, markdown } = brief;
const unavailable = metadata.status === "failed" || markdown === null;
const failedGeneration = metadata.status === "failed";
const unavailableGenerationMode = failedGeneration ? "retry" : "regenerate";
const csrf = Astro.locals.adminSession!.csrfToken;
const error = Astro.url.searchParams.get("error");
const success = Astro.url.searchParams.get("success");
const generationInfo = await loadAdminBriefGenerationInfo(date);
const generationRunning = generationInfo.generation.running;

const STAGE_LABELS = {
  light_discovery: "סריקה רחבה",
  gap_discovery: "בדיקת פערים",
  keyword_discovery: "מיקוד אדמין",
  deep_research: "מחקר עומק וסינון",
} as const;

const STATUS_OPTIONS = [
  { value: "draft", label: "טיוטה" },
  { value: "ready", label: "מוכן" },
  { value: "published", label: "פורסם" },
  { value: "failed", label: "נכשל" },
] as const;
const INTENSITY_OPTIONS = [
  { value: "minimal", label: "מינימלי" },
  { value: "low", label: "נמוך" },
  { value: "medium", label: "בינוני" },
  { value: "high", label: "גבוה" },
  { value: "extreme", label: "קיצוני" },
] as const;
const COUNT_FIELDS = [
  { name: "significant_items", label: "משמעותיים", value: metadata.significant_items },
  { name: "worth_watching_items", label: "שווה לעקוב", value: metadata.worth_watching_items },
  { name: "source_count", label: "מקורות", value: metadata.source_count },
] as const;
const CHIP_GROUPS = [
  { name: "companies", label: "חברות", addLabel: "הוספת חברה", items: metadata.companies, wide: false },
  { name: "topics", label: "נושאים", addLabel: "הוספת נושא", items: metadata.topics, wide: false },
  { name: "developments", label: "תקצירי התפתחויות", addLabel: "הוספת תקציר", items: metadata.developments, wide: true },
] as const;

const statusIndex = Math.max(0, STATUS_OPTIONS.findIndex((option) => option.value === metadata.status));
const intensityIndex = Math.max(0, INTENSITY_OPTIONS.findIndex((option) => option.value === metadata.day_intensity));
---
<AdminLayout title={`עריכת ${date}`}>
  {error && <p class="form-error" role="alert">{error}</p>}
  {success && <p class="form-success" role="status">{success}</p>}
  {generationRunning && (
    <div class="generation-running" role="status" data-generation-running>
      <span class="generation-running-dot" aria-hidden="true"></span>
      <div><strong>היצירה מתבצעת ברקע</strong><span>העמוד יתרענן אוטומטית כשההרצה תתקדם.</span></div>
    </div>
  )}
  {unavailable ? (
    <section class="friendly-state friendly-state-error admin-friendly-state" role="status">
      <div class="friendly-state-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4M12 16h.01" /><path d="M10.3 3.6 2.4 17.2A2 2 0 0 0 4.1 20h15.8a2 2 0 0 0 1.7-2.8L13.7 3.6a2 2 0 0 0-3.4 0Z" /></svg>
      </div>
      <p class="eyebrow">{failedGeneration ? "התדריך לא הושלם" : "קובץ התדריך חסר"}</p>
      <h1>{failedGeneration ? "אופס, ההפקה נעצרה בדרך" : "התוכן זקוק לשחזור"}</h1>
      <p>{failedGeneration
        ? `לא נוצר תדריך תקין עבור ${date}, ולכן אין עדיין תוכן שאפשר לפרסם. התקלה כבר מופיעה במערכת ההתראות של האדמין.`
        : `רשומת ${date} קיימת, אבל קובץ ה־Markdown שלה אינו זמין. אפשר ליצור את התוכן מחדש דרך ה־pipeline המלא.`}</p>
      <div class="friendly-state-actions">
        <form action={`/api/admin/briefs/${date}/generate`} method="post">
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="mode" value={unavailableGenerationMode} />
          <button class="button" type="submit" disabled={generationRunning}>
            {generationRunning ? "מריץ מחדש…" : failedGeneration ? "ניסיון יצירה מחדש" : "שחזור באמצעות יצירה מחדש"}
          </button>
        </form>
        <a class="button" href="/admin/alerts">לצפייה בהתראות</a>
        <a class="button secondary" href="/admin">חזרה לניהול התדריכים</a>
      </div>
    </section>
  ) : (
    <>
  <section class="editor" data-editor>
    <header class="editor-topbar">
      <div class="editor-topbar-title">
        <p class="eyebrow">תדריך</p>
        <h1>{date}</h1>
      </div>
      <div class="editor-topbar-tools">
        <form action={`/api/admin/briefs/${date}/generate`} method="post" data-regenerate-form>
          <input type="hidden" name="csrf_token" value={csrf} />
          <input type="hidden" name="mode" value="regenerate" />
          <button type="button" class="button secondary editor-regenerate" data-regenerate disabled={generationRunning}>
            {generationRunning ? "יוצר מחדש…" : "יצירה מחדש"}
          </button>
        </form>
        <div class="segmented segmented-sm" data-segmented data-editor-mode aria-label="מצב תצוגה" style="--count:2;--index:0">
          <span class="segmented-thumb" aria-hidden="true"></span>
          <label class="is-active"><input type="radio" name="__mode" value="edit" checked /><span>עריכה</span></label>
          <label><input type="radio" name="__mode" value="preview" /><span>תצוגה</span></label>
        </div>
        <button type="button" class="icon-button editor-copy" data-copy aria-label="העתקת ה־Markdown" title="העתקת ה־Markdown">
          <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2" /><path d="M5 15V6a2 2 0 0 1 2-2h9" /></svg>
          <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 13 4 4 10-11" /></svg>
        </button>
      </div>
    </header>

    <form class="editor-body" data-editor-form action={`/api/admin/briefs/${date}`} method="post">
      <input type="hidden" name="csrf_token" value={csrf} />

      <div class="editor-canvas">
        <div class="editor-canvas-head">
          <span>Markdown</span>
          <span class="editor-canvas-hint" data-md-count></span>
        </div>
        <textarea id="markdown" name="markdown" rows="20" spellcheck="false" required>{markdown}</textarea>
        <div class="editor-canvas-preview" data-editor-preview>
          <div class="article-body" data-preview-body></div>
        </div>
      </div>

      <div class="editor-meta" data-editor-meta>
        <div class="meta-card meta-card-wide">
          <h2 class="meta-card-title">תקציר</h2>
          <textarea name="summary" rows="3" maxlength="2000" required>{metadata.summary}</textarea>
        </div>

        <div class="meta-card meta-card-wide">
          <h2 class="meta-card-title">מדדים</h2>
          <div class="meta-counts">
            {COUNT_FIELDS.map((count) => (
              <label>
                <input name={count.name} type="number" min="0" inputmode="numeric" value={count.value} required />
                <span>{count.label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="meta-card">
          <h2 class="meta-card-title">סטטוס</h2>
          <div class="segmented" data-segmented aria-label="סטטוס" style={`--count:${STATUS_OPTIONS.length};--index:${statusIndex}`}>
            <span class="segmented-thumb" aria-hidden="true"></span>
            {STATUS_OPTIONS.map((option) => (
              <label class={metadata.status === option.value ? "is-active" : undefined}>
                <input type="radio" name="status" value={option.value} checked={metadata.status === option.value} required />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </div>

        <div class="meta-card">
          <h2 class="meta-card-title">עצימות</h2>
          <div class="segmented" data-segmented aria-label="עצימות" style={`--count:${INTENSITY_OPTIONS.length};--index:${intensityIndex}`}>
            <span class="segmented-thumb" aria-hidden="true"></span>
            {INTENSITY_OPTIONS.map((option) => (
              <label class={metadata.day_intensity === option.value ? "is-active" : undefined}>
                <input type="radio" name="day_intensity" value={option.value} checked={metadata.day_intensity === option.value} required />
                <span>{option.label}</span>
              </label>
            ))}
          </div>
        </div>

        {CHIP_GROUPS.map((group) => (
          <div class={group.wide ? "meta-card meta-card-wide" : "meta-card"} data-chip-field>
            <h2 class="meta-card-title">{group.label}</h2>
            <div class="chip-list" data-chip-list data-chip-name={group.name}>
              {(group.items.length ? group.items : [""]).map((value) => (
                <div class="chip-row">
                  <input class="chip-input" name={group.name} value={value} maxlength="200" />
                  <button type="button" class="chip-remove" data-chip-remove aria-label="הסרה">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 12h12" /></svg>
                  </button>
                </div>
              ))}
            </div>
            <button type="button" class="chip-add" data-chip-add>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 6v12M6 12h12" /></svg>
              {group.addLabel}
            </button>
          </div>
        ))}
      </div>

      <div class="editor-footer">
        <button class="button" name="action" value="save" type="submit" disabled={generationRunning}>שמירת שינויים</button>
        <button class="danger-button" name="action" value="delete" type="submit" formnovalidate data-delete disabled={generationRunning}>מחיקת התדריך</button>
      </div>
    </form>
  </section>

  <EditorFormControls />

  <dialog class="confirm-dialog" data-delete-dialog>
    <form method="dialog" class="confirm-dialog-body">
      <h2>מחיקת התדריך</h2>
      <p>הפעולה תמחק לצמיתות את קובץ ה־Markdown ואת רשומת המטא־דאטה של {date}. אין דרך לשחזר.</p>
      <div class="confirm-dialog-actions">
        <button type="submit" value="cancel" class="button secondary">ביטול</button>
        <button type="submit" value="confirm" class="danger-button">מחיקה לצמיתות</button>
      </div>
    </form>
  </dialog>

  <dialog class="confirm-dialog" data-regenerate-dialog>
    <form method="dialog" class="confirm-dialog-body">
      <h2>יצירת התדריך מחדש</h2>
      <p>המערכת תריץ מחדש את כל שלבי המחקר והכתיבה עבור {date} ותדרוס את התוכן הנוכחי. אם התדריך כבר פורסם, הוא יישאר מפורסם ונתוני הסטטיסטיקה שלו יעודכנו לתוכן החדש.</p>
      <div class="confirm-dialog-actions">
        <button type="submit" value="cancel" class="button secondary">ביטול</button>
        <button type="submit" value="confirm" class="button">יצירה מחדש</button>
      </div>
    </form>
  </dialog>

  <script is:inline>
    (() => {
      const editor = document.querySelector("[data-editor]");
      if (!editor) return;
      const form = editor.querySelector("[data-editor-form]");
      const markdownEl = editor.querySelector("#markdown");
      const csrf = form.querySelector('[name="csrf_token"]').value;

      const copyButton = editor.querySelector("[data-copy]");
      copyButton?.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(markdownEl.value);
          copyButton.classList.add("is-copied");
          setTimeout(() => copyButton.classList.remove("is-copied"), 1600);
        } catch (_error) { /* clipboard unavailable */ }
      });

      const mdCount = editor.querySelector("[data-md-count]");
      const updateCount = () => {
        if (mdCount) mdCount.textContent = markdownEl.value.length.toLocaleString("he-IL") + " תווים";
      };
      updateCount();

      const previewBody = editor.querySelector("[data-preview-body]");
      let previewTimer;
      const refreshPreview = () => {
        fetch("/api/admin/brief-preview", {
          method: "POST",
          headers: { "Content-Type": "application/x-www-form-urlencoded" },
          body: new URLSearchParams({ csrf_token: csrf, markdown: markdownEl.value }),
        })
          .then((response) => (response.ok ? response.text() : Promise.reject(new Error(String(response.status)))))
          .then((html) => { previewBody.innerHTML = html; })
          .catch(() => { previewBody.textContent = "לא ניתן להציג תצוגה מקדימה כרגע."; });
      };
      editor.querySelectorAll("[data-editor-mode] input").forEach((input) => {
        input.addEventListener("change", () => {
          const preview = input.value === "preview" && input.checked;
          editor.classList.toggle("mode-preview", preview);
          if (preview) refreshPreview();
        });
      });
      markdownEl.addEventListener("input", () => {
        updateCount();
        if (!editor.classList.contains("mode-preview")) return;
        clearTimeout(previewTimer);
        previewTimer = setTimeout(refreshPreview, 350);
      });

      const dialog = document.querySelector("[data-delete-dialog]");
      const deleteButton = editor.querySelector("[data-delete]");
      if (dialog && deleteButton && typeof dialog.showModal === "function") {
        deleteButton.addEventListener("click", (event) => {
          event.preventDefault();
          dialog.returnValue = "";
          dialog.showModal();
        });
        dialog.addEventListener("close", () => {
          if (dialog.returnValue === "confirm") form.requestSubmit(deleteButton);
        });
      }
    })();
  </script>
    </>
  )}

  <section class="research-trace" aria-labelledby="research-trace-title">
    <header class="research-trace-head">
      <div>
        <p class="eyebrow">שקיפות מחקר</p>
        <h2 id="research-trace-title">מה כל שלב מצא ומה נשאר</h2>
      </div>
      {generationInfo.research && <span>הרצה {generationInfo.research.runId.slice(0, 8)}</span>}
    </header>
    {generationInfo.research && generationInfo.research.stages.length > 0 ? (
      <div class="research-stage-grid">
        {generationInfo.research.stages.map((stage, index) => (
          <article class:list={["research-stage-card", { "is-skipped": stage.state === "skipped", "is-failed": stage.state === "failed" }]}>
            <div class="research-stage-title">
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{STAGE_LABELS[stage.key]}</h3>
            </div>
            {stage.state === "skipped" ? (
              <p class="research-stage-empty">השלב לא הופעל בהרצה הזאת.</p>
            ) : (
              <>
                {stage.state === "failed" && <p class="research-stage-failed">השלב נעצר בזמן אימות התוצאות.</p>}
                <div class="research-stage-metrics">
                  <span><strong>{stage.foundCount}</strong> נמצאו</span>
                  <span><strong>{stage.contributedCount}</strong> המשיכו</span>
                  <span><strong>{stage.filteredCount + stage.rejectedCount}</strong> סוננו</span>
                </div>
                <div class="research-stage-block">
                  <span class="research-stage-label">נושאים</span>
                  <div class="research-topic-list">
                    {stage.topics.length > 0
                      ? stage.topics.slice(0, 8).map((topic) => <span>{topic}</span>)
                      : <span class="is-empty">לא דווחו נושאים</span>}
                  </div>
                </div>
                {stage.contributedTitles.length > 0 && (
                  <div class="research-stage-block">
                    <span class="research-stage-label">המשיכו הלאה</span>
                    <ul>{stage.contributedTitles.slice(0, 4).map((title) => <li>{title}</li>)}</ul>
                  </div>
                )}
                {stage.filteredTitles.length > 0 && (
                  <details class="research-filtered">
                    <summary>מה סונן בשלב הזה</summary>
                    <ul>{stage.filteredTitles.slice(0, 6).map((title) => <li>{title}</li>)}</ul>
                  </details>
                )}
              </>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="research-trace-empty">עדיין אין נתוני מחקר שמורים עבור התדריך הזה. הם יופיעו לאחר ההרצה הבאה.</p>
    )}
  </section>

  <script is:inline>
    (() => {
      const regenerateForm = document.querySelector("[data-regenerate-form]");
      const regenerateButton = document.querySelector("[data-regenerate]");
      const regenerateDialog = document.querySelector("[data-regenerate-dialog]");
      if (regenerateForm && regenerateButton && regenerateDialog && typeof regenerateDialog.showModal === "function") {
        regenerateButton.addEventListener("click", () => regenerateDialog.showModal());
        regenerateDialog.addEventListener("close", () => {
          if (regenerateDialog.returnValue === "confirm") regenerateForm.requestSubmit();
        });
      }
      if (document.querySelector("[data-generation-running]")) {
        setTimeout(() => window.location.reload(), 6000);
      }
    })();
  </script>
</AdminLayout>
