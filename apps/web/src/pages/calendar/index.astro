---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalendarMonth from "../../components/CalendarMonth.astro";
import { loadSiteSnapshot } from "../../lib/content.js";

export const prerender = false;
const snapshot = await loadSiteSnapshot();
const month = snapshot.currentDate.slice(0, 7);
---

<BaseLayout description="כל מהדורות Daily Tech לפי יום וחודש.">
  <section class="shell calendar-shell">
    <div class="calendar-page-heading">
      <h1 class="section-title">לוח המהדורות</h1>
    </div>
    <CalendarMonth month={month} currentDate={snapshot.currentDate} briefs={snapshot.published} />
  </section>
</BaseLayout>
