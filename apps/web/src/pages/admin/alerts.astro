---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import InboxList, { type InboxItem } from "../../components/InboxList.astro";
import { presentAlert } from "../../lib/admin-alerts.js";
import { formatIsraelDateTime } from "../../lib/dates.js";
import { openServerDatabase } from "../../server/database.js";

const db = await openServerDatabase();
let alerts;
try { alerts = db.operations.listTickets({ category: "system", limit: 500 }); }
finally { db.close(); }
const csrf = Astro.locals.adminSession!.csrfToken;
const items: InboxItem[] = alerts.map((alert) => {
  const view = presentAlert(alert);
  return {
    id: `alert-${alert.id}`, title: view.title, summary: view.summary, timestamp: alert.createdAt,
    tags: [{ label: alert.status === "open" ? "דורש טיפול" : "טופל", tone: alert.status === "open" ? "warn" : "ok" }],
    meta: [
      { label: "נרשם", value: formatIsraelDateTime(alert.createdAt) },
      ...(view.stage ? [{ label: "שלב", value: view.stage }] : []),
      ...(view.briefDate ? [{ label: "תאריך התקציר", value: view.briefDate }] : []),
      ...(alert.resolvedAt ? [{ label: "סומן כטופל", value: formatIsraelDateTime(alert.resolvedAt) }] : []),
    ],
    body: alert.body, technical: true,
    actions: [
      ...(view.briefDate ? [{ label: "פתיחת התקציר", href: `/admin/briefs/${view.briefDate}` }] : []),
      ...(view.logsHref ? [{ label: view.runId ? "לוגים של הריצה" : "לוגים של התאריך", href: view.logsHref }] : []),
    ],
    resolveAction: alert.status === "open" ? `/api/admin/feedback/${alert.id}` : null,
    filters: { status: alert.status },
  };
});
const openAlertCount = alerts.filter((alert) => alert.status === "open").length;
const resolvedAlertCount = alerts.length - openAlertCount;
const filterGroups = [{
  key: "status", label: "סטטוס", defaultValue: "open",
  options: [{ value: "open", label: "דורש טיפול" }, { value: "resolved", label: "טופל" }],
}];
---
<AdminLayout title="התראות">
  <section class="inbox-page inbox-page-alerts">
    <header class="inbox-hero">
      <div class="inbox-hero-copy">
        <span class="inbox-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" /></svg></span>
        <div><p class="inbox-eyebrow">מרכז טיפול</p><h1>התראות מערכת</h1><p>מה השתבש, באיזה תקציר ומה דורש טיפול.</p></div>
      </div>
      <dl class="inbox-overview" aria-label="סיכום ההתראות ברשימה">
        <div class="is-primary"><dt>דורשות טיפול</dt><dd>{openAlertCount}</dd></div>
        <div><dt>התראות שטופלו</dt><dd>{resolvedAlertCount}</dd></div>
        <div><dt>ברשימה</dt><dd>{alerts.length}</dd></div>
      </dl>
    </header>
    <p class="admin-notice">מוצגות עד 500 ההתראות האחרונות. סימון כטופל מתעד טיפול בהתראה ואינו מפעיל מחדש את ההרצה. <a href="/admin/logs">לכל הלוגים ←</a></p>
    <InboxList items={items} filterGroups={filterGroups} csrf={csrf} variant="alerts" searchPlaceholder="חיפוש בהתראות…" emptyText="אין התראות שתואמות לחיפוש ולסינון שבחרת. אפשר לעבור להיסטוריית ההתראות שטופלו." />
  </section>
</AdminLayout>
