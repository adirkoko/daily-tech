---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import InboxList, { type InboxItem } from "../../components/InboxList.astro";
import { formatIsraelDateTime } from "../../lib/dates.js";
import { openServerDatabase } from "../../server/database.js";

const CATEGORY_LABELS: Record<string, string> = {
  general: "כללי",
  correction: "תיקון",
  suggestion: "הצעה",
};

const db = await openServerDatabase();
const tickets = db.operations.listTickets({ limit: 500 });
db.close();
const csrf = Astro.locals.adminSession!.csrfToken;

const items: InboxItem[] = tickets
  .filter((ticket) => ticket.category !== "system")
  .map((ticket) => ({
    id: `feedback-${ticket.id}`,
    title: ticket.title,
    timestamp: ticket.createdAt,
    tags: [
      { label: CATEGORY_LABELS[ticket.category] ?? ticket.category, tone: "accent" },
      { label: ticket.status === "open" ? "פתוח" : "טופל", tone: ticket.status === "open" ? "warn" : "ok" },
    ],
    meta: [
      ...(ticket.submitterName ? [{ label: "מאת", value: ticket.submitterName }] : []),
      { label: "התקבל", value: formatIsraelDateTime(ticket.createdAt) },
      ...(ticket.resolvedAt ? [{ label: "טופל", value: formatIsraelDateTime(ticket.resolvedAt) }] : []),
    ],
    body: ticket.body,
    resolveAction: ticket.status === "open" ? `/api/admin/feedback/${ticket.id}` : null,
    filters: { status: ticket.status, category: ticket.category },
  }));

const feedbackTickets = tickets.filter((ticket) => ticket.category !== "system");
const openCount = feedbackTickets.filter((ticket) => ticket.status === "open").length;
const resolvedCount = feedbackTickets.length - openCount;

const filterGroups = [
  {
    key: "status",
    label: "סטטוס",
    options: [
      { value: "open", label: "פתוח" },
      { value: "resolved", label: "טופל" },
    ],
  },
  {
    key: "category",
    label: "קטגוריה",
    options: [
      { value: "general", label: "כללי" },
      { value: "correction", label: "תיקון" },
      { value: "suggestion", label: "הצעה" },
    ],
  },
];
---
<AdminLayout title="פניות">
  <section class="inbox-page inbox-page-feedback">
    <header class="inbox-hero">
      <div class="inbox-hero-copy">
        <span class="inbox-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" /><path d="M8 9h8M8 13h5" /></svg></span>
        <div><p class="inbox-eyebrow">Feedback inbox</p><h1>פניות משתמשים</h1><p>מרכז אחד להצעות, תיקונים ופניות כלליות שהתקבלו מהאתר.</p></div>
      </div>
      <dl class="inbox-overview" aria-label="סיכום פניות">
        <div class="is-primary"><dt>ממתינות לטיפול</dt><dd>{openCount}</dd></div>
        <div><dt>טופלו</dt><dd>{resolvedCount}</dd></div>
        <div><dt>סך הכול</dt><dd>{feedbackTickets.length}</dd></div>
      </dl>
    </header>
    <InboxList
      items={items}
      filterGroups={filterGroups}
      csrf={csrf}
      variant="feedback"
      searchPlaceholder="חיפוש בפניות…"
      emptyText="אין פניות שתואמות לחיפוש או לסינון שבחרת."
    />
  </section>
</AdminLayout>
