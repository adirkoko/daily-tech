---
export const prerender = false;
import AdminLayout from "../../layouts/AdminLayout.astro";
import InboxList, { type InboxItem } from "../../components/InboxList.astro";
import { formatIsraelDateTime } from "../../lib/dates.js";
import { openServerDatabase } from "../../server/database.js";

const LEVEL_LABELS: Record<string, string> = { error: "שגיאה", warning: "אזהרה", info: "מידע" };

const db = await openServerDatabase();
const alerts = db.operations.listTickets({ category: "system", limit: 500 });
const logs = db.operations.listLogs({ level: "error", limit: 100 });
db.close();
const csrf = Astro.locals.adminSession!.csrfToken;

const ticketItems: InboxItem[] = alerts.map((alert) => ({
  id: `alert-${alert.id}`,
  title: alert.title,
  timestamp: alert.createdAt,
  tags: [
    { label: "התראה", tone: "danger" },
    { label: alert.status === "open" ? "פתוח" : "טופל", tone: alert.status === "open" ? "warn" : "ok" },
  ],
  meta: [
    { label: "נרשם", value: formatIsraelDateTime(alert.createdAt) },
    ...(alert.resolvedAt ? [{ label: "טופל", value: formatIsraelDateTime(alert.resolvedAt) }] : []),
  ],
  body: alert.body,
  resolveAction: alert.status === "open" ? `/api/admin/feedback/${alert.id}` : null,
  filters: { type: "alert", status: alert.status },
}));

const logItems: InboxItem[] = logs.map((log) => ({
  id: `log-${log.id}`,
  title: log.eventType,
  timestamp: log.occurredAt,
  tags: [
    { label: "לוג", tone: "neutral" },
    { label: LEVEL_LABELS[log.level] ?? log.level, tone: log.level === "error" ? "danger" : "warn" },
  ],
  meta: [
    { label: "מתי", value: formatIsraelDateTime(log.occurredAt) },
    ...(log.briefDate ? [{ label: "תדריך", value: log.briefDate }] : []),
    ...(log.runId ? [{ label: "מזהה ריצה", value: log.runId }] : []),
  ],
  body:
    [log.message, Object.keys(log.details).length > 0 ? JSON.stringify(log.details, null, 2) : null]
      .filter(Boolean)
      .join("\n\n") || null,
  filters: { type: "log" },
}));

const items = [...ticketItems, ...logItems];
const openAlertCount = alerts.filter((alert) => alert.status === "open").length;
const resolvedAlertCount = alerts.length - openAlertCount;
const filterGroups = [
  {
    key: "type",
    label: "סוג",
    options: [
      { value: "alert", label: "התראות" },
      { value: "log", label: "לוגים" },
    ],
  },
  {
    key: "status",
    label: "סטטוס",
    options: [
      { value: "open", label: "פתוח" },
      { value: "resolved", label: "טופל" },
    ],
  },
];
---
<AdminLayout title="התראות">
  <section class="inbox-page inbox-page-alerts">
    <header class="inbox-hero">
      <div class="inbox-hero-copy">
        <span class="inbox-hero-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" /></svg></span>
        <div><p class="inbox-eyebrow">System health</p><h1>התראות מערכת</h1><p>תקלות פעילות, אירועי כשל והיסטוריית טיפול במקום אחד.</p></div>
      </div>
      <dl class="inbox-overview" aria-label="סיכום התראות">
        <div class="is-primary"><dt>דורשות טיפול</dt><dd>{openAlertCount}</dd></div>
        <div><dt>אירועי כשל</dt><dd>{logs.length}</dd></div>
        <div><dt>התראות שטופלו</dt><dd>{resolvedAlertCount}</dd></div>
      </dl>
    </header>
    <InboxList
      items={items}
      filterGroups={filterGroups}
      csrf={csrf}
      variant="alerts"
      searchPlaceholder="חיפוש בהתראות ובלוגים…"
      emptyText="אין התראות או לוגים שתואמים לחיפוש ולסינון שבחרת."
    />
  </section>
</AdminLayout>
