---
import "../styles/global.css";
interface Props { title: string; }
const { title } = Astro.props;
const csrf = Astro.locals.adminSession?.csrfToken;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="robots" content="noindex,nofollow" /><title>{title} — Daily Tech Admin</title></head>
  <body class="admin-body">
    <header class="admin-header"><a class="brand" href="/admin"><span class="brand-mark">DT</span><span>ניהול</span></a>{csrf && <nav><a href="/admin">תדריכים</a><a href="/admin/feedback">פידבק</a><a href="/admin/alerts">התראות</a><form action="/api/admin/logout" method="post"><input type="hidden" name="csrf_token" value={csrf} /><button type="submit">יציאה</button></form></nav>}</header>
    <main class="admin-main"><slot /></main>
  </body>
</html>
