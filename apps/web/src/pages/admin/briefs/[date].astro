---
export const prerender = false;
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { loadAdminBrief } from "../../../server/admin-content.js";
const date = Astro.params.date ?? "";
const brief = await loadAdminBrief(date);
if (!brief) return Astro.redirect("/admin?error=brief-not-found", 303);
const { metadata, markdown } = brief;
const csrf = Astro.locals.adminSession!.csrfToken;
const error = Astro.url.searchParams.get("error"); const success = Astro.url.searchParams.get("success");
---
<AdminLayout title={`עריכת ${date}`}><div class="admin-title"><div><p class="eyebrow">עריכת תדריך</p><h1>{date}</h1></div><button class="button secondary" type="button" data-copy>העתקת Markdown</button></div>{error && <p class="form-error" role="alert">{error}</p>}{success && <p class="form-success" role="status">{success}</p>}<form class="brief-editor" action={`/api/admin/briefs/${date}`} method="post"><input type="hidden" name="csrf_token" value={csrf} /><label class="wide">Markdown<textarea id="markdown" name="markdown" rows="28" required>{markdown}</textarea></label><label class="wide">תקציר<textarea name="summary" rows="3" required maxlength="2000">{metadata.summary}</textarea></label><label>משמעותיים<input name="significant_items" type="number" min="0" value={metadata.significant_items} required /></label><label>שווה לעקוב<input name="worth_watching_items" type="number" min="0" value={metadata.worth_watching_items} required /></label><label>מקורות<input name="source_count" type="number" min="0" value={metadata.source_count} required /></label><label>עצימות<select name="day_intensity">{["minimal","low","medium","high","extreme"].map((value) => <option value={value} selected={metadata.day_intensity === value}>{value}</option>)}</select></label><label>סטטוס<select name="status">{["draft","ready","published","failed"].map((value) => <option value={value} selected={metadata.status === value}>{value}</option>)}</select></label><label class="wide">חברות — אחת בשורה<textarea name="companies" rows="4">{metadata.companies.join("\n")}</textarea></label><label class="wide">נושאים — אחד בשורה<textarea name="topics" rows="4">{metadata.topics.join("\n")}</textarea></label><label class="wide">תקצירי התפתחויות — אחד בשורה<textarea name="developments" rows="7">{metadata.developments.join("\n")}</textarea></label><div class="admin-actions wide"><button class="button" name="action" value="save" type="submit">שמירה</button><button class="danger-button" name="action" value="delete" type="submit" formnovalidate data-delete>מחיקה</button></div></form><script is:inline>document.querySelector('[data-copy]')?.addEventListener('click',async()=>{const value=document.querySelector('#markdown')?.value;if(typeof value==='string')await navigator.clipboard.writeText(value);});document.querySelector('[data-delete]')?.addEventListener('click',(event)=>{if(!confirm('למחוק את התדריך לצמיתות?'))event.preventDefault();});</script></AdminLayout>
