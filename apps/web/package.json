{
  "name": "@daily-tech/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "prebuild": "npm run build --workspace @daily-tech/pipeline --workspace @daily-tech/publisher",
    "build": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "start": "cross-env ASTRO_TELEMETRY_DISABLED=1 node --env-file=../../.env dist/server/entry.mjs",
    "pretest": "npm run build --workspace @daily-tech/pipeline --workspace @daily-tech/publisher",
    "test": "vitest run",
    "pretypecheck": "npm run build --workspace @daily-tech/pipeline --workspace @daily-tech/publisher",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^11.1.4",
    "@daily-tech/core": "0.1.0",
    "@daily-tech/db": "0.1.0",
    "@daily-tech/pipeline": "0.1.0",
    "@daily-tech/publisher": "0.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sanitize-html": "^2.16.1",
    "astro": "^7.2.9",
    "marked": "^18.0.11",
    "sanitize-html": "^2.17.7",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "typescript": "~5.9.3"
  }
}
