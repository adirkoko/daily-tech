---
import { formatIsraelDateTime } from "../lib/dates.js";

export interface InboxTag {
  label: string;
  tone?: "neutral" | "accent" | "ok" | "warn" | "danger";
}
export interface InboxItem {
  id: string;
  title: string;
  timestamp: string;
  tags: InboxTag[];
  meta?: { label: string; value: string }[];
  body?: string | null;
  summary?: string;
  actions?: { label: string; href: string }[];
  technical?: boolean;
  /** When set, a "mark resolved" button is shown once the row is expanded. */
  resolveAction?: string | null;
  /** Filter dimensions, e.g. { status: "open", category: "general" }. */
  filters?: Record<string, string>;
}
export interface InboxFilterGroup {
  key: string;
  label: string;
  options: { value: string; label: string }[];
  defaultValue?: string;
}

interface Props {
  items: InboxItem[];
  filterGroups?: InboxFilterGroup[];
  csrf: string;
  emptyText?: string;
  variant?: "feedback" | "alerts" | "logs";
  searchPlaceholder?: string;
  pageSize?: number;
}

const {
  items,
  pageSize = 15,
  filterGroups = [],
  csrf,
  emptyText = "אין פריטים שתואמים לסינון.",
  variant = "feedback",
  searchPlaceholder = "חיפוש בכותרת…",
} = Astro.props;
---
<section class={`inbox inbox-${variant}`} data-inbox data-page-size={pageSize}>
  <div class="inbox-controls">
    <div class="inbox-toolbar-main">
      <label class="inbox-search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
        <input type="search" data-inbox-search placeholder={searchPlaceholder} aria-label="חיפוש בפריטים" />
      </label>
      <p class="inbox-count" data-inbox-count aria-live="polite"></p>
    </div>

    <div class="inbox-filterbar">
      {filterGroups.map((group) => (
        <div class="inbox-filter-set">
          <span class="inbox-filter-label">{group.label}</span>
          <div class="inbox-filter" data-filter-group={group.key} data-filter-default={group.defaultValue ?? ""} role="group" aria-label={group.label}>
            <button type="button" class:list={["inbox-chip", { "is-active": !group.defaultValue }]} aria-pressed={!group.defaultValue} data-filter-value="">הכול</button>
            {group.options.map((option) => (
              <button type="button" class:list={["inbox-chip", { "is-active": group.defaultValue === option.value }]} aria-pressed={group.defaultValue === option.value} data-filter-value={option.value}>{option.label}</button>
            ))}
          </div>
        </div>
      ))}

      <div class="inbox-filter-set inbox-sort-set">
        <span class="inbox-filter-label">סדר</span>
        <div class="inbox-sort" role="group" aria-label="מיון">
          <button type="button" class="inbox-chip is-active" aria-pressed="true" data-sort="desc">חדשים</button>
          <button type="button" class="inbox-chip" aria-pressed="false" data-sort="asc">ישנים</button>
        </div>
      </div>
    </div>
  </div>

  <ul class="inbox-list" data-inbox-list>
    {items.map((item, index) => (
      <li
        class="inbox-row"
        data-inbox-row
        data-timestamp={item.timestamp}
        data-search={[item.title, item.summary, item.body, ...(item.meta ?? []).map((entry) => entry.value)].filter(Boolean).join(" ").toLocaleLowerCase("he")}
        {...Object.fromEntries(
          Object.entries(item.filters ?? {}).map(([key, value]) => [`data-filter-${key}`, value]),
        )}
      >
        <button
          class="inbox-row-head"
          type="button"
          aria-expanded="false"
          aria-controls={`inbox-body-${index}`}
          data-inbox-toggle
        >
          <span class="inbox-row-signal" aria-hidden="true">
            {variant === "logs" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m7 9 2 2-2 2M12 14h5" /></svg>
            ) : variant === "alerts" && item.filters?.status === "resolved" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.7 2.7L16.5 9" /></svg>
            ) : variant === "alerts" ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9M10 21h4" /><path d="M12 7v4M12 14h.01" /></svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4Z" /><path d="M8 9h8M8 13h5" /></svg>
            )}
          </span>
          <span class="inbox-row-main">
            <span class="inbox-row-title">{item.title}</span>
            {item.summary && <span class="inbox-row-summary">{item.summary}</span>}
            <span class="inbox-row-tags">
              {item.tags.map((tag) => (
                <span class={`inbox-tag tone-${tag.tone ?? "neutral"}`}>{tag.label}</span>
              ))}
            </span>
          </span>
          <time class="inbox-row-time" datetime={item.timestamp}>{formatIsraelDateTime(item.timestamp)}</time>
          <svg class="inbox-row-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
        </button>

        <div class="inbox-row-body" id={`inbox-body-${index}`} hidden>
          {item.meta && item.meta.length > 0 && (
            <div class="inbox-meta">
              {item.meta.map((entry) => (
                <div class="inbox-meta-row"><span>{entry.label}</span><span>{entry.value}</span></div>
              ))}
            </div>
          )}
          {item.actions && <div class="inbox-item-actions">{item.actions.map((action) => <a class="button secondary" href={action.href}>{action.label}</a>)}</div>}
          {item.body && (item.technical ? (
            <details class="inbox-technical"><summary>פרטים טכניים</summary><pre class="inbox-body-text" dir="auto">{item.body}</pre></details>
          ) : <pre class="inbox-body-text" dir="auto">{item.body}</pre>)}
          {item.resolveAction && (
            <form class="inbox-resolve" action={item.resolveAction} method="post">
              <input type="hidden" name="csrf_token" value={csrf} />
              <button class="button secondary" type="submit">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                סימון כטופל
              </button>
            </form>
          )}
        </div>
      </li>
    ))}
  </ul>

  <div class="inbox-empty" data-inbox-empty hidden>
    <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h16v12H4zM4 7l3-4h10l3 4M8 12h8" /></svg></span>
    <strong>אין כאן פריטים כרגע</strong>
    <p>{emptyText}</p>
  </div>

  <nav class="inbox-pager" data-inbox-pager hidden aria-label="ניווט עמודים">
    <button type="button" class="inbox-pager-button" data-pager-prev aria-label="עמוד קודם">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
    </button>
    <span class="inbox-pager-label" data-pager-label></span>
    <button type="button" class="inbox-pager-button" data-pager-next aria-label="עמוד הבא">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg>
    </button>
  </nav>
</section>

<script is:inline>
  (() => {
    const inbox = document.querySelector("[data-inbox]");
    if (!inbox) return;
    const list = inbox.querySelector("[data-inbox-list]");
    const rows = Array.from(inbox.querySelectorAll("[data-inbox-row]"));
    const search = inbox.querySelector("[data-inbox-search]");
    const countEl = inbox.querySelector("[data-inbox-count]");
    const emptyEl = inbox.querySelector("[data-inbox-empty]");
    const pager = inbox.querySelector("[data-inbox-pager]");
    const pagerPrev = inbox.querySelector("[data-pager-prev]");
    const pagerNext = inbox.querySelector("[data-pager-next]");
    const pagerLabel = inbox.querySelector("[data-pager-label]");
    const PAGE_SIZE = Number(inbox.dataset.pageSize) || 15;
    const total = rows.length;
    const selected = {};
    let sortDir = "desc";
    let query = "";
    let page = 0;

    const matches = (row) => {
      if (query && !(row.dataset.search || "").includes(query)) return false;
      for (const key in selected) {
        const want = selected[key];
        if (!want) continue;
        const have = row.getAttribute("data-filter-" + key);
        if (have !== want) return false;
      }
      return true;
    };

    const apply = () => {
      const matched = rows
        .filter(matches)
        .sort((a, b) => {
          const cmp = a.dataset.timestamp.localeCompare(b.dataset.timestamp);
          return sortDir === "asc" ? cmp : -cmp;
        });
      const pages = Math.max(1, Math.ceil(matched.length / PAGE_SIZE));
      page = Math.min(Math.max(page, 0), pages - 1);
      const start = page * PAGE_SIZE;

      for (const row of rows) row.hidden = true;
      matched.slice(start, start + PAGE_SIZE).forEach((row) => {
        row.hidden = false;
        list.append(row);
      });

      if (countEl) {
        countEl.textContent = matched.length === total
          ? total + " פריטים"
          : matched.length + " מתוך " + total;
      }
      if (emptyEl) emptyEl.hidden = matched.length !== 0;
      if (pager) {
        pager.hidden = matched.length <= PAGE_SIZE;
        if (pagerLabel) pagerLabel.textContent = "עמוד " + (page + 1) + " מתוך " + pages;
        if (pagerPrev) pagerPrev.disabled = page === 0;
        if (pagerNext) pagerNext.disabled = page >= pages - 1;
      }
    };

    const resetToFirstPage = () => {
      page = 0;
      apply();
    };

    inbox.querySelectorAll("[data-inbox-toggle]").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        const row = toggle.closest(".inbox-row");
        const body = row.querySelector(".inbox-row-body");
        const open = toggle.getAttribute("aria-expanded") === "true";
        toggle.setAttribute("aria-expanded", String(!open));
        row.classList.toggle("is-open", !open);
        if (body) body.hidden = open;
      });
    });

    inbox.querySelectorAll("[data-filter-group]").forEach((group) => {
      const key = group.dataset.filterGroup;
      selected[key] = group.dataset.filterDefault || "";
      group.querySelectorAll("[data-filter-value]").forEach((button) => {
        button.addEventListener("click", () => {
          selected[key] = button.dataset.filterValue;
          group.querySelectorAll("[data-filter-value]").forEach((other) => {
            other.classList.toggle("is-active", other === button);
            other.setAttribute("aria-pressed", String(other === button));
          });
          resetToFirstPage();
        });
      });
    });

    inbox.querySelectorAll("[data-sort]").forEach((button) => {
      button.addEventListener("click", () => {
        sortDir = button.dataset.sort;
        inbox.querySelectorAll("[data-sort]").forEach((other) => {
          other.classList.toggle("is-active", other === button);
          other.setAttribute("aria-pressed", String(other === button));
        });
        resetToFirstPage();
      });
    });

    search?.addEventListener("input", () => {
      query = search.value.trim().toLowerCase();
      resetToFirstPage();
    });

    pagerPrev?.addEventListener("click", () => {
      if (page === 0) return;
      page -= 1;
      apply();
      list.scrollIntoView({ block: "start", behavior: "smooth" });
    });
    pagerNext?.addEventListener("click", () => {
      page += 1;
      apply();
      list.scrollIntoView({ block: "start", behavior: "smooth" });
    });

    apply();
  })();
</script>
