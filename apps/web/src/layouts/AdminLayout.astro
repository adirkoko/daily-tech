---
import "../styles/global.css";

import LogoMark from "../components/LogoMark.astro";
import ThemeToggle from "../components/ThemeToggle.astro";

interface Props { title?: string; }
const csrf = Astro.locals.adminSession?.csrfToken;
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#f4f5f7" data-theme-color />
    <link rel="icon" type="image/svg+xml" sizes="any" href="/favicon.svg?v=4" />
    <title>Daily Tech Admin</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("daily-tech-theme");
        const preferred = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        const theme = saved === "light" || saved === "dark" ? saved : preferred;
        document.documentElement.dataset.theme = theme;
        document.querySelector("[data-theme-color]")?.setAttribute("content", theme === "dark" ? "#1b1c20" : "#f4f5f7");
      })();
    </script>
  </head>
  <body class="admin-body">
    <header class="admin-header">
      <a class="brand" href="/admin"><span class="brand-mark" aria-hidden="true"><LogoMark /></span><span>ניהול</span></a>
      <div class="admin-header-actions">
        {csrf && (
          <nav>
            <a href="/admin" aria-current={pathname === "/admin" || pathname.startsWith("/admin/briefs/") ? "page" : undefined}>תדריכים</a>
            <a href="/admin/feedback" aria-current={pathname === "/admin/feedback" ? "page" : undefined}>פידבק</a>
            <a href="/admin/alerts" aria-current={pathname === "/admin/alerts" ? "page" : undefined}>התראות</a>
            <a href="/admin/settings" aria-current={pathname === "/admin/settings" ? "page" : undefined}>הגדרות</a>
            <form action="/api/admin/logout" method="post" data-logout-form>
              <input type="hidden" name="csrf_token" value={csrf} />
              <button type="submit" class="admin-logout" data-logout>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /></svg>
                יציאה
              </button>
            </form>
          </nav>
        )}
        <ThemeToggle />
      </div>
    </header>
    <main class="admin-main"><slot /></main>

    {csrf && (
      <dialog class="confirm-dialog" data-logout-dialog>
        <form method="dialog" class="confirm-dialog-body">
          <h2>יציאה מאזור הניהול</h2>
          <p>הפעולה תסיים את החיבור הנוכחי ותצטרך להזין את הסיסמה שוב כדי לחזור.</p>
          <div class="confirm-dialog-actions">
            <button type="submit" value="cancel" class="button secondary">ביטול</button>
            <button type="submit" value="confirm" class="button">יציאה</button>
          </div>
        </form>
      </dialog>
    )}
    <script is:inline>
      const toggle = document.querySelector("[data-theme-toggle]");
      const syncThemeControl = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        toggle?.setAttribute("aria-pressed", String(dark));
        toggle?.setAttribute("aria-label", dark ? "מעבר למצב יום" : "מעבר למצב לילה");
        document.querySelector("[data-theme-color]")?.setAttribute("content", dark ? "#1b1c20" : "#f4f5f7");
      };
      syncThemeControl();
      toggle?.addEventListener("click", () => {
        const root = document.documentElement;
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("daily-tech-theme", next);
        syncThemeControl();
      });

      const logoutForm = document.querySelector("[data-logout-form]");
      const logoutButton = document.querySelector("[data-logout]");
      const logoutDialog = document.querySelector("[data-logout-dialog]");
      if (logoutForm && logoutButton && logoutDialog && typeof logoutDialog.showModal === "function") {
        logoutButton.addEventListener("click", (event) => {
          event.preventDefault();
          logoutDialog.returnValue = "";
          logoutDialog.showModal();
        });
        logoutDialog.addEventListener("close", () => {
          if (logoutDialog.returnValue === "confirm") logoutForm.submit();
        });
      }
    </script>
  </body>
</html>
