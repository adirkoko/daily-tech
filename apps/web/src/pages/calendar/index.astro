---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CalendarMonth from "../../components/CalendarMonth.astro";
import { getSiteSnapshot } from "../../lib/content.js";

export const prerender = false;
const snapshot = await getSiteSnapshot();
const month = snapshot.currentDate.slice(0, 7);
---

<BaseLayout description="כל מהדורות Daily Tech לפי יום וחודש." ambient>
  <section class="shell calendar-shell public-page public-calendar">
    <div class="calendar-page-heading">
      <h1 class="section-title">לוח המהדורות</h1>
    </div>
    <CalendarMonth
      month={month}
      currentDate={snapshot.currentDate}
      days={snapshot.published.map((brief) => brief.metadata)}
    />
  </section>
</BaseLayout>
