# AI provider: chat completions for writing + Responses-compatible web research
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=replace-with-model-name
AI_BASE_URL=https://api.openai.com/v1

# Content and metadata storage
TECH_BRIEFS_ROOT=./tech_briefs
SITE_URL=http://localhost:4321

PUBLISH_LEASE_DURATION_MS=600000

# Pipeline safety limit (1-3)
PIPELINE_MAX_REVISION_ROUNDS=3

# Admin single-service runtime
ADMIN_PASSWORD_HASH=scrypt$131072$8$1$replace-with-salt$replace-with-hash
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_TTL_HOURS=12
# Keep enabled behind HTTPS. Set to false only for local HTTP development.
ADMIN_SECURE_COOKIES=true
LOGIN_RATE_LIMIT_WINDOW_HOURS=12
FEEDBACK_RATE_LIMIT_WINDOW_HOURS=12
TRUSTED_PROXY_HOPS=0

# In-process daily scheduler (Israel local time)
SCHEDULER_ENABLED=false
SCHEDULER_GENERATE_TIME=01:00
SCHEDULER_PUBLISH_TIME=07:00
SCHEDULER_POLL_SECONDS=30
SCHEDULER_LEASE_HOURS=6
