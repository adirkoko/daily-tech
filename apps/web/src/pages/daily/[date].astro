---
import BaseLayout from "../../layouts/BaseLayout.astro";
import IntensityBadge from "../../components/IntensityBadge.astro";
import { formatHebrewDate } from "../../lib/dates.js";
import { getSiteSnapshot, renderBrief } from "../../lib/content.js";

export const prerender = false;
const snapshot = await getSiteSnapshot();
const date = Astro.params.date ?? "";
const briefIndex = snapshot.published.findIndex((item) => item.metadata.date === date);
const requestedDay = snapshot.days.find((item) => item.date === date) ?? null;
const brief = briefIndex >= 0 ? snapshot.published[briefIndex]! : null;
const unavailableDay = brief === null && requestedDay?.status === "failed" ? requestedDay : null;
if (brief === null && unavailableDay === null) return Astro.redirect("/404", 302);
if (unavailableDay !== null) {
  Astro.response.status = 503;
  Astro.response.headers.set("Retry-After", "3600");
}
const newer = brief === null ? null : snapshot.published[briefIndex - 1] ?? null;
const older = brief === null ? null : snapshot.published[briefIndex + 1] ?? null;
const day = brief?.metadata ?? unavailableDay!;
const html = brief === null ? null : await renderBrief(brief);

const dayMonth = (value: string): string =>
  new Intl.DateTimeFormat("he-IL", { timeZone: "UTC", day: "numeric", month: "long" }).format(
    new Date(`${value}T12:00:00Z`),
  );
---

<BaseLayout description={day.summary} noindex={unavailableDay !== null} ambient>
  {unavailableDay ? (
    <section class="shell friendly-state friendly-state-error public-page" role="status">
      <div class="friendly-state-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4M12 16h.01" /><path d="M10.3 3.6 2.4 17.2A2 2 0 0 0 4.1 20h15.8a2 2 0 0 0 1.7-2.8L13.7 3.6a2 2 0 0 0-3.4 0Z" /></svg>
      </div>
      <p class="eyebrow">המהדורה לא זמינה</p>
      <h1>אופס, משהו השתבש בדרך</h1>
      <p>לא הצלחנו להשלים את המהדורה של {formatHebrewDate(day.date)}. התקלה נרשמה במערכת, ובינתיים אפשר לחזור למהדורות שכבר פורסמו.</p>
      <div class="friendly-state-actions">
        <a class="button" href="/">חזרה לעמוד הבית</a>
        <a class="button secondary" href="/calendar">לוח המהדורות</a>
      </div>
    </section>
  ) : (
    <>
  <article class="shell article-layout public-page public-article">
    {day.day_intensity === "minimal" && (
      <div class="status-note">
        <span class="status-dot"></span>
        <span>זה היה יום שקט יחסית בטכנולוגיה — התדריך קצר בהתאם.</span>
      </div>
    )}
    <div class="article-meta" aria-label="פרטי המהדורה">
      <span class="article-meta-date">{formatHebrewDate(day.date, { weekday: "long" })}</span>
      <span class="article-meta-separator" aria-hidden="true"></span>
      <span>{day.significant_items} אירועים משמעותיים</span>
      <span class="article-meta-separator" aria-hidden="true"></span>
      <IntensityBadge level={day.day_intensity} />
    </div>
    <div class="article-body article-glass" set:html={html}></div>
  </article>

  {(older || newer) && (
    <nav class="shell article-nav" aria-label="מעבר בין מהדורות">
      {older ? (
        <a
          class="article-nav-link is-older"
          href={`/daily/${older.metadata.date}`}
          rel="prev"
          aria-label={`למהדורה הקודמת מ־${formatHebrewDate(older.metadata.date)}`}
        >
          <span class="article-nav-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
          <span class="article-nav-date">
            <small>המהדורה הקודמת</small>
            <strong>{dayMonth(older.metadata.date)}</strong>
          </span>
        </a>
      ) : (
        <span aria-hidden="true"></span>
      )}
      {newer ? (
        <a
          class="article-nav-link is-newer"
          href={`/daily/${newer.metadata.date}`}
          rel="next"
          aria-label={`למהדורה מ־${formatHebrewDate(newer.metadata.date)}`}
        >
          <span class="article-nav-date">
            <small>המהדורה הבאה</small>
            <strong>{dayMonth(newer.metadata.date)}</strong>
          </span>
          <span class="article-nav-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg>
          </span>
        </a>
      ) : (
        <span aria-hidden="true"></span>
      )}
    </nav>
  )}
    </>
  )}
</BaseLayout>
