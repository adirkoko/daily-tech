# OpenAI-compatible model provider
AI_API_KEY=replace-with-provider-api-key
AI_MODEL=replace-with-model-name
AI_BASE_URL=https://api.openai.com/v1

# Web research
BRAVE_SEARCH_API_KEY=replace-with-brave-search-api-key

# Content and metadata storage
TECH_BRIEFS_ROOT=./tech_briefs
SITE_URL=http://localhost:4321

# Pipeline safety limit (1-3)
PIPELINE_MAX_REVISION_ROUNDS=3

# Admin (used when apps/web implements the server-side admin area)
ADMIN_PASSWORD=replace-with-a-long-random-password
LOGIN_RATE_LIMIT_WINDOW_HOURS=12
