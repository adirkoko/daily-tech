# Application
# Root directory for generated content and the SQLite database.
TECH_BRIEFS_ROOT=./tech_briefs

# Public HTTP(S) origin. Compose also passes it into the image build for
# canonical URLs and validated reverse-proxy origin reconstruction.
SITE_URL=http://localhost:4321

# Metadata snapshot cache lifetime in seconds.
SITE_SNAPSHOT_CACHE_TTL_SECONDS=10

# Admin
# Required. Minimum 14 characters.
ADMIN_PASSWORD=replace_with_admin_password

# Required. Random secret with at least 32 characters.
ADMIN_SESSION_SECRET=replace_with_random_session_secret

# Session and rate-limit windows are expressed in hours.
ADMIN_SESSION_TTL_HOURS=12

# Set to false only when developing over local HTTP.
ADMIN_SECURE_COOKIES=true
LOGIN_RATE_LIMIT_WINDOW_HOURS=12
FEEDBACK_RATE_LIMIT_WINDOW_HOURS=12

# Number of trusted reverse-proxy hops.
TRUSTED_PROXY_HOPS=0

# AI
# Required for brief generation.
AI_API_KEY=replace_with_provider_api_key
AI_MODEL=replace_with_model_name
AI_BASE_URL=https://api.openai.com/v1

# Publication
# Lease duration in milliseconds.
PUBLISH_LEASE_DURATION_MS=600000

# Scheduler (Asia/Jerusalem). Generate/publish times are an Admin > Pipeline
# setting (stored in pipeline_settings), not env — see docs/admin.md.
SCHEDULER_ENABLED=false

# Poll interval in seconds; lease duration in hours.
SCHEDULER_POLL_SECONDS=30
SCHEDULER_LEASE_HOURS=6

# Development only
# Destructive demo-data commands also require --confirm-reset.
ALLOW_DESTRUCTIVE_DEMO_DATA_RESET=false
